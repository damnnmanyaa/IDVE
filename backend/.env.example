DB_HOST=localhost
DB_PORT=5432
DB_NAME=idve_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=jdbc:postgresql://localhost:5432/idve_db
DB_SSLMODE=disable
REDIS_ENABLED=false
REDIS_URL=rediss://default:your_upstash_token@your-upstash-host:6379
RESEND_API_KEY=your_resend_api_key
MAIL_FROM=IDVE <onboarding@example.com>
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=replace_with_a_long_demo_password
DEMO_RESET_ENABLED=false
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
APP_JWT_SECRET=your_jwt_secret_here
OAUTH2_REDIRECT_URI=http://localhost:5173/login
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_sender_email@example.com
MAIL_PASSWORD=your_app_password
